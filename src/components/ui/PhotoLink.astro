---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; class?: string; sizes?: string; photoId?: string; naturalRatio?: boolean; }
const { src, alt, caption, class: className, sizes = '(max-width: 699px) calc(100vw - 48px), 50vw', photoId, naturalRatio = false } = Astro.props;
const enlarged = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp', quality: 82 });
const width = Number(enlarged.attributes.width);
const height = Number(enlarged.attributes.height);
---
<figure class:list={['photo-figure', className]} data-photo-id={photoId}>
  <a class="photo-link" href={enlarged.src} data-pswp-width={width} data-pswp-height={height} aria-label={`Ampliar: ${alt}`}>
    <Picture src={src} width={Math.min(src.width, 960)} formats={['webp']} fallbackFormat="jpg" widths={[320, 480, 640, 960].filter(width => width <= src.width)} sizes={sizes} alt={alt} loading="lazy" quality={80} style={naturalRatio ? `aspect-ratio:${src.width}/${src.height}` : undefined} />
    <span class="photo-expand"><Icon name="expand" size={18} /></span>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
