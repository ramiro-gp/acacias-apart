---
import { destinationPhotoColumns } from '../../data/photos';
import EditorialGallery from '../ui/EditorialGallery.astro';
---
<section id="la-paz" class="destination-section shell" aria-labelledby="destination-title">
  <span id="linkpaz" class="fragment-alias" aria-hidden="true"></span>
  <div class="section-heading"><div><p class="eyebrow">LA PAZ, ENTRE RÍOS</p><h2 id="destination-title">Hay lugares que<br />invitan a <em>quedarse.</em></h2></div><p>Atardeceres junto al agua.<br />Postales para tu próxima escapada.</p></div>
  <div data-gallery="la-paz"><EditorialGallery columns={destinationPhotoColumns} class="destination-photos" /></div>
</section>
