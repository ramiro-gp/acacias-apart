---
import { photo, destinationPhotoIds } from '../../data/photos';
import PhotoLink from '../ui/PhotoLink.astro';
---
<section id="linkpaz" class="destination-section shell" aria-labelledby="destination-title">
  <div class="section-heading"><div><p class="eyebrow">LA PAZ, ENTRE RÍOS</p><h2 id="destination-title">Hay lugares que<br />invitan a <em>quedarse.</em></h2></div><p>Atardeceres junto al agua.<br />Postales para tu próxima escapada.</p></div>
  <div data-gallery="la-paz"><div class="destination-photos">{destinationPhotoIds.map(id => { const item = photo(id); return <PhotoLink src={item.image} alt={item.alt} photoId={id} sizes="(max-width: 699px) calc(100vw - 48px), 42vw" />; })}</div></div>
</section>
