---
import '../styles/global.css';
import 'photoswipe/style.css';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import socialPhoto from '../assets/photos/complex-01.jpg';
interface Props { title?: string; description?: string; }
const { title = 'Departamentos turísticos en La Paz, Entre Ríos | Acacias Apart', description = 'Disfrutá de tu estadía en nuestros departamentos equipados, con piscina, parque y espacios para descansar. Conocé los alojamientos y consultanos por WhatsApp.' } = Astro.props;
const socialImage = await getImage({ src: socialPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const absoluteImage = new URL(socialImage.src, site.canonical).href;
const indexable = site.releaseReady && !Astro.url.pathname.startsWith('/404');
const schema = {
  '@context': 'https://schema.org', '@type': 'LodgingBusiness', '@id': `${site.canonical}#alojamiento`,
  name: site.name, url: site.canonical, description,
  image: absoluteImage, logo: new URL('/brand/wordmark.svg', site.canonical).href,
  telephone: site.phoneInternational, email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: site.locality, addressRegion: site.region, addressCountry: 'AR' },
  hasMap: site.mapsUrl, sameAs: [site.instagram, site.facebook],
  checkinTime: '12:00', checkoutTime: '10:00',
  petsAllowed: 'Solo en los departamentos de dos ambientes y monoambiente, según reglamento.',
  amenityFeature: ['Piscina', 'Parque', 'Parrillas compartidas', 'Wifi gratuito', 'Estacionamiento', 'Aire acondicionado', 'Ropa blanca'].map(name => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('nav-enhanced');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#263e32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.canonical)} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/fraunces-latin-italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Parque y piscina de Acacias Apart" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <script>
      import '../scripts/navigation';
    </script>
  </body>
</html>
